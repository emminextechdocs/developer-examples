{
  "uid": "reliability-lab",
  "title": "Provisioned checkout lab",
  "schemaVersion": 41,
  "version": 1,
  "timezone": "utc",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "title": "Prometheus self-scrape",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prom-lab"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"prometheus\"}",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Synthetic checkout requests / second",
      "datasource": {
        "type": "prometheus",
        "uid": "prom-lab"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_request_duration_seconds_count{service=\"checkout\"}[5m]))",
          "legendFormat": "checkout"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Synthetic slow-request fraction",
      "datasource": {
        "type": "prometheus",
        "uid": "prom-lab"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "service:slow_requests:ratio5m",
          "legendFormat": "checkout"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Synthetic latency budget burn",
      "datasource": {
        "type": "prometheus",
        "uid": "prom-lab"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "service:slow_requests:ratio5m / 0.001",
          "legendFormat": "checkout"
        }
      ]
    }
  ]
}
